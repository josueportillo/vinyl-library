# Copy this file to `.env.local` for local development, or set these as
# environment variables on Vercel (Settings → Environment Variables).
# Never commit real values — `.env*` is gitignored (except this example).

# --- Storage (required) ---------------------------------------------------
# Vercel Blob read/write token. Provisioned via `vercel blob` or the dashboard.
BLOB_READ_WRITE_TOKEN=""

# --- Discogs (metadata lookup + collection import) ------------------------
# Personal access token (read-only fallback when no OAuth account is connected).
# Optional but recommended — raises the API rate limit.
DISCOGS_TOKEN=""

# Discogs OAuth 1.0a consumer credentials (enables "Connect your Discogs
# account" and auto-mirroring new records to the user's Discogs collection).
DISCOGS_CONSUMER_KEY=""
DISCOGS_CONSUMER_SECRET=""

# --- Google OAuth (sign-in) ------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Authorized redirect URI: https://<your-domain>/api/auth/google-callback

# --- Spotify (mini player + direct album links) ----------------------------
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
